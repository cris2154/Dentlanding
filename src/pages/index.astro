---
import Layout from '../layouts/Layout.astro';
import PageWiper from '../components/PageWiper';
import { getImage } from 'astro:assets';

import clinica1Src from '../assets/images/clinica1.jpg';
import clinica2Src from '../assets/images/clinica2.jpg';
import clinica3Src from '../assets/images/clinica3.jpg';
import limpiezaSrc from '../assets/images/limpieza_dental.png';
import ortodonciaSrc from '../assets/images/ortodoncia.png';
import implantesSrc from '../assets/images/implantes.png';
import blanqueamientoSrc from '../assets/images/blanqueamiento.png';
import endodonciaSrc from '../assets/images/endodoncia.png';
import odontopediatriaSrc from '../assets/images/odontopediatria.png';

const optClinica1 = await getImage({ src: clinica1Src, format: 'webp', width: 800 });
const optClinica2 = await getImage({ src: clinica2Src, format: 'webp', width: 800 });
const optClinica3 = await getImage({ src: clinica3Src, format: 'webp', width: 800 });
const optLimpieza = await getImage({ src: limpiezaSrc, format: 'webp', width: 400 });
const optOrtodoncia = await getImage({ src: ortodonciaSrc, format: 'webp', width: 400 });
const optImplantes = await getImage({ src: implantesSrc, format: 'webp', width: 400 });
const optBlanqueamiento = await getImage({ src: blanqueamientoSrc, format: 'webp', width: 400 });
const optEndodoncia = await getImage({ src: endodonciaSrc, format: 'webp', width: 400 });
const optOdontopediatria = await getImage({ src: odontopediatriaSrc, format: 'webp', width: 400 });

const optimizedImages = {
  clinica1: optClinica1.src,
  clinica2: optClinica2.src,
  clinica3: optClinica3.src,
  limpieza: optLimpieza.src,
  ortodoncia: optOrtodoncia.src,
  implantes: optImplantes.src,
  blanqueamiento: optBlanqueamiento.src,
  endodoncia: optEndodoncia.src,
  odontopediatria: optOdontopediatria.src
};
---

<Layout>
	<main class="main-container">
		<PageWiper client:load optimizedImages={optimizedImages} />


		<!-- FOOTER REALISTA -->
		<div class="footer-wrapper">
			<footer class="site-footer">
				<div class="footer-inner">
					<div class="footer-grid">
						<div class="gsap-reveal footer-brand">
							<h2>Dent<span>Studio</span></h2>
							<p>
								Revolucionando el cuidado dental con tecnología de punta y un trato humano excepcional. Tu sonrisa, nuestra obra de arte.
							</p>
							<div class="social-icons">
								<a href="#" class="social-icon" aria-label="Instagram">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
								</a>
								<a href="#" class="social-icon" aria-label="Facebook">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
								</a>
								<a href="#" class="social-icon" aria-label="Twitter">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
								</a>
							</div>
						</div>
						<div class="gsap-reveal footer-col">
							<h4>Clínica</h4>
							<ul class="footer-links">
								<li><a href="#">Sobre Nosotros</a></li>
								<li><a href="#">Nuestros Especialistas</a></li>
								<li><a href="#">Instalaciones</a></li>
								<li><a href="#">Testimonios</a></li>
							</ul>
						</div>
						<div class="gsap-reveal footer-col">
							<h4>Servicios</h4>
							<ul class="footer-links">
								<li><a href="#">Limpieza Dental</a></li>
								<li><a href="#">Ortodoncia Invisible</a></li>
								<li><a href="#">Implantes 3D</a></li>
								<li><a href="#">Blanqueamiento</a></li>
							</ul>
						</div>
						<div class="gsap-reveal footer-col">
							<h4>Contacto</h4>
							<ul class="footer-contact">
								<li>
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
									Av. de la Sonrisa 123, Madrid
								</li>
								<li>
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
									+34 900 123 456
								</li>
								<li>
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
									hola@dentstudio.com
								</li>
								<li style="margin-top: 0.5rem; display: block;">
									<button class="footer-btn">Agendar Cita</button>
								</li>
							</ul>
						</div>
					</div>

					<div class="footer-bottom">
						<div>&copy; {new Date().getFullYear()} DentStudio. Todos los derechos reservados.</div>
						<div class="footer-bottom-links">
							<a href="#">Política de Privacidad</a>
							<a href="#">Aviso Legal</a>
							<a href="#">Cookies</a>
						</div>
					</div>
				</div>
			</footer>
		</div>
	</main>
</Layout>

<style>
	.main-container {
		position: relative;
		width: 100%;
	}
	
	.white-section {
		min-height: 100vh;
		width: 100%;
		background-color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

	.footer-wrapper {
		background-color: #075985;
		padding-top: 2rem;
		padding-bottom: 0;
	}
	.site-footer {
		background-color: #0c4a6e;
		color: #ffffff;
		padding: 4rem 2rem 2rem 2rem;
		border-top-left-radius: 3rem;
		border-top-right-radius: 3rem;
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
		margin: 0 1rem 0 1rem;
		border-top: 1px solid #075985;
		border-left: 1px solid #075985;
		border-right: 1px solid #075985;
		border-bottom: none;
		box-shadow: 0 -10px 40px rgba(0,0,0,0.2);
		display: flex;
		justify-content: center;
	}
	@media (min-width: 768px) {
		.site-footer {
			margin: 0 2rem 0 2rem;
		}
	}
	.footer-inner {
		width: 100%;
		max-width: 1200px;
		display: flex;
		flex-direction: column;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1.5fr;
		gap: 3rem;
		margin-bottom: 3rem;
	}
	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
	.footer-brand h2 {
		font-size: 2rem;
		margin: 0 0 1rem 0;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: #fff;
	}
	.footer-brand h2 span {
		color: #0ea5e9;
	}
	.footer-brand p {
		color: #9ca3af;
		font-size: 0.875rem;
		line-height: 1.6;
		max-width: 300px;
	}
	.footer-col h4 {
		font-weight: 700;
		color: #ffffff;
		margin-bottom: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 0.875rem;
	}
	.footer-links, .footer-contact {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.footer-links li a, .footer-contact li {
		font-size: 0.875rem;
		color: #9ca3af;
		text-decoration: none;
		transition: color 0.3s;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.footer-links li a:hover {
		color: #ffffff;
	}
	.social-icons {
		display: flex;
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.social-icon {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 1px solid #4b5563;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #d1d5db;
		text-decoration: none;
		transition: all 0.3s;
		font-size: 0.875rem;
		font-weight: bold;
	}
	.social-icon:hover {
		color: #ffffff;
		border-color: #ffffff;
	}
	.footer-btn {
		background-color: transparent;
		color: #fff;
		border: 2px solid #0ea5e9;
		padding: 0.8rem 1.2rem;
		border-radius: 999px;
		cursor: pointer;
		font-weight: 600;
		width: 100%;
		transition: background-color 0.3s, color 0.3s;
	}
	.footer-btn:hover {
		background-color: #0ea5e9;
		color: #fff;
	}
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid #1f2937;
		padding-top: 2rem;
		color: #9ca3af;
		font-size: 0.875rem;
	}
	@media (max-width: 768px) {
		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
	}
	.footer-bottom-links {
		display: flex;
		gap: 1.5rem;
	}
	.footer-bottom-links a {
		color: #9ca3af;
		text-decoration: none;
		transition: color 0.3s;
	}
	.footer-bottom-links a:hover {
		color: #ffffff;
	}
</style>

<script>
	import { gsap } from "gsap";
	
	const initAnimations = () => {
		const footer = document.querySelector('.site-footer') || document.querySelector('footer');
		if (footer) {
			const cols = footer.querySelectorAll('.footer-grid .gsap-reveal');
			gsap.set(cols, { opacity: 0, y: 50 });

			const footerObserver = new IntersectionObserver((entries) => {
				if (entries[0].isIntersecting) {
					gsap.to(cols, {
						y: 0,
						opacity: 1,
						duration: 1.5,
						stagger: 0.2,
						ease: "power2.out"
					});
					footerObserver.disconnect();
				}
			}, { threshold: 0.2 });

			footerObserver.observe(footer);
		}
	};

	// Ejecutar animaciones al montar
	if (document.readyState === 'complete') {
		initAnimations();
	} else {
		window.addEventListener('load', initAnimations);
	}
	document.addEventListener('astro:page-load', initAnimations);
</script>
